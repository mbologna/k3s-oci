# Remote state in a separate OCI Object Storage bucket, through the S3 API.
# Copy to backend_override.tf (gitignored by *_override.tf) and fill in the <...>.
#
# Do not use the module's <cluster_name>-terraform-state bucket: the nodes have
# manage objects on it, the state holds every cluster secret, and destroy/clean
# delete it. Create a bucket the nodes have no IAM grant on:
#
#   oci os bucket create -c <compartment_ocid> --name <cluster_name>-tofu-state \
#     --versioning Enabled --public-access-type NoPublicAccess
#
# The [oci-tofu-state] profile in ~/.aws/credentials holds a Customer Secret Key
# (access key ID + secret). The namespace is in `tofu output terraform_state_backend`.
# Migrate an existing local state with `tofu init -migrate-state`.

terraform {
  backend "s3" {
    bucket                      = "<cluster_name>-tofu-state"
    key                         = "terraform.tfstate"
    region                      = "<region>" # e.g. eu-frankfurt-1
    profile                     = "oci-tofu-state"
    endpoints                   = { s3 = "https://<namespace>.compat.objectstorage.<region>.oraclecloud.com" }
    use_path_style              = true
    use_lockfile                = true # OpenTofu >= 1.10 / Terraform >= 1.11
    skip_region_validation      = true
    skip_credentials_validation = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
    skip_s3_checksum            = true
  }
}
